{
  "name": "fyp-management-system",
  "version": "1.0.0",
  "description": "FYP Management System for UiTM",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "db:sync": "node server/config/syncDb.js",
    "db:seed": "node server/seeders/seed.js",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "@cyntler/react-doc-viewer": "^1.17.1",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "pdfkit": "^0.15.0",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
